<+><?xml version=\"1.0\" encoding=\"utf-8\"?>\r\n<resources xmlns:ns1=\"urn:oasis:names:tc:xliff:document:1.2\">\r\n    <string msgid=\"881409763997275156\" name=\"call_notification_answer_action\">\"පිළිතුරු දෙ.\"</string>\r\n    <string msgid=\"8793775615905189152\" name=\"call_notification_answer_video_action\">\"වීඩියෝ\"</string>\r\n    <string msgid=\"3229508546291798546\" name=\"call_notification_decline_action\">\"ප්\u200Dරතික්ෂේප ක\"</string>\r\n    <string msgid=\"2659457946726154263\" name=\"call_notification_hang_up_action\">\"විසන්ධි කරන්න\"</string>\r\n    <string msgid=\"6107532579223922871\" name=\"call_notification_incoming_text\">\"එන ඇමතුම\"</string>\r\n    <string msgid=\"8623827134497363134\" name=\"call_notification_ongoing_text\">\"කරගෙන යන ඇමතුම\"</string>\r\n    <string msgid=\"59049573811482460\" name=\"call_notification_screening_text\">\"එන ඇමතුමක් පරීක්ෂා කරන්න\"</string>\r\n    <string msgid=\"406453423630273620\" name=\"close_drawer\">\"සංචාලන මෙනුව වසන්න\"</string>\r\n    <string msgid=\"7573152094250666567\" name=\"close_sheet\">\"පත්\u200Dරය වසන්න\"</string>\r\n    <string msgid=\"2523291102206661146\" name=\"common_google_play_services_enable_button\">සබල කරන්න</string>\r\n    <string msgid=\"227660514972886228\" name=\"common_google_play_services_enable_text\">ඔබ Google Play සේවා සබල කරන්නේ නම් මිස %1$s වැඩ නොකරනු ඇත.</string>\r\n    <string msgid=\"5122002158466380389\" name=\"common_google_play_services_enable_title\">Google Play සේවා සබල කරන්න</string>\r\n    <string msgid=\"7153882981874058840\" name=\"common_google_play_services_install_button\">ස්ථාපනය කරන්න</string>\r\n    <string name=\"common_google_play_services_install_text\">ඔබගේ ටැබ්ලට් පරිගණකයේ නැති Google Play සේවා නොමැතිව %1$s ධාවනය නොවනු ඇත.</string>\r\n    <string msgid=\"7215213145546190223\" name=\"common_google_play_services_install_title\">Google Play සේවා ලබා ගන්න</string>\r\n    <string name=\"common_google_play_services_notification_channel_name\">Google Play සේවාවල ලබා ගත හැකි බව</string>\r\n    <string name=\"common_google_play_services_notification_ticker\">Google Play සේවා දෝෂය</string>\r\n    <string name=\"common_google_play_services_unknown_issue\">%1$s හට Google Play සේවා සමගින් ගැටලු ඇත. කරුණාකර නැවත උත්සාහ කරන්න.</string>\r\n    <string name=\"common_google_play_services_unsupported_text\">ඔබගේ උපාංගය මගින් සහාය නොදක්වන, Google Play සේවා නොමැතිව %1$s ධාවනය නොවනු ඇත.</string>\r\n    <string msgid=\"6556509956452265614\" name=\"common_google_play_services_update_button\">යාවත්කාලීන කරන්න</string>\r\n    <string msgid=\"9053896323427875356\" name=\"common_google_play_services_update_text\">Google Play සේවා යාවත්කාලීන කරන්නේ නොමැතිව %1$s ධාවනය නොවේ.</string>\r\n    <string msgid=\"6006316683626838685\" name=\"common_google_play_services_update_title\">Google Play සේවා යාවත්කාලීන කරන්න</string>\r\n    <string name=\"common_google_play_services_updating_text\">දැනට යාවත්කාලීන කරමින් ඇති, Google Play සේවා නොමැතිව %1$s ධාවනය නොවනු ඇත.</string>\r\n    <string name=\"common_google_play_services_wear_update_text\">Google Play සේවාවල නව අනුවාදයක් අවශ්\u200Dයයි. එය මද වේලාවකින් එය විසින්ම යාවත්කාලීන වනු ඇත.</string>\r\n    <string name=\"common_open_on_phone\">දුරකථනය තුළ විවෘත කරන්න</string>\r\n    <string name=\"common_signin_button_text\">පුරන්න</string>\r\n    <string name=\"common_signin_button_text_long\">Google සමගින් පුරන්න</string>\r\n    <string msgid=\"3260749812566568062\" name=\"copy_toast_msg\">\"සබැඳිය පසුරු පුවරුවට පිටපත් කෙරිණි\"</string>\r\n    <string msgid=\"8038256446254964252\" name=\"default_error_message\">\"වලංගු නොවන ආදානයකි\"</string>\r\n    <string msgid=\"6312721426453364202\" name=\"default_popup_window_title\">\"උත්පතන කවුළුව\"</string>\r\n    <string msgid=\"1890207353314751437\" name=\"dropdown_menu\">\"පතන මෙනුව\"</string>\r\n    <string msgid=\"4566929209979330987\" name=\"fallback_menu_item_copy_link\">\"සබැඳිය පිටපත් කරන්න\"</string>\r\n    <string msgid=\"3413186855122069269\" name=\